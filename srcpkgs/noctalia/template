# Template file for 'noctalia'
pkgname=noctalia
_basever=5.0.0
_commit=cd06851db4f40ab61d219a903518a1ca03fc3db3
_shortcommit=cd06851
_gitdate=20260812202000
version="${_basever}+git${_gitdate}.${_shortcommit}"
revision=1

build_style=meson
buildtype=release
configure_args="-Db_ndebug=true -Dtests=disabled -Db_lto=false"

# noctalia at _commit 451c391 requires C++23 <flat_set>/<print>, only
# available in libstdc++ from GCC 16+.  Build with our parallel gcc16 and
# rpath its libstdc++ so the binary resolves GLIBCXX_3.4.34+ symbols at
# runtime even on systems carrying only Void's gcc14 libstdc++.
depends+=" libstdc++16>=16.1.1"
LDFLAGS+=" -Wl,-rpath,/opt/gcc16/lib64"
short_desc="A sleek, customizable desktop shell crafted for Wayland"
maintainer="Quietcraft <https://github.com/Ackerman-00>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia"

distfiles="https://github.com/noctalia-dev/noctalia/archive/${_commit}.tar.gz"
checksum="295caa63153b06c83c921ddbe4c58f043ecff4fbe8c44edccd5fab1df0fa5e57"

replaces="noctalia-v5>=0 noctalia-beta>=0"

hostmakedepends="meson ninja pkg-config"

makedepends="
 gcc16 libstdc++16-devel
 wayland-devel wayland-protocols libepoxy-devel
 MesaLib-devel libglvnd-devel cairo-devel
 pango-devel fontconfig-devel freetype-devel
 harfbuzz-devel libxkbcommon-devel pipewire-devel wireplumber-devel
 libsecret-devel libsodium-devel libical-devel
 libcurl-devel pam-devel libwebp-devel libjxl-devel libsndfile-devel
 basu-devel sdbus-c++-devel
 libmd4c-devel tomlplusplus-devel
 json-c++ stb
 polkit-devel librsvg-devel libqalculate-devel libxml2-devel jemalloc-devel
 glib-devel
"

pre_configure() {
	export CC=/usr/bin/gcc16
	export CXX=/usr/bin/g++16
}

post_install() {
    vlicense LICENSE
    vdoc README.md

    if [ ! -x "${DESTDIR}/usr/bin/noctalia" ]; then
        msg_error "Expected binary /usr/bin/noctalia not found.\n"
    fi
}
