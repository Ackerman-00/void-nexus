# Template file for 'noctalia'
pkgname=noctalia
_basever=5.1.0
_commit=9c936446a9cbee712d76891c0cb2d625a6bc5411
_shortcommit=9c93644
_gitdate=20260916130915
# NOTE: dynamic version= (from _vars) is intentional -- check-updates.yml
# rewrites _commit/_gitdate and leaves version= to expand at build time.
# xlint flags "_" chars from variable NAMES here; value itself is clean.
version="${_basever}+git${_gitdate}.${_shortcommit}"
revision=1

build_style=meson
# meson release buildtype (asserts off via -Db_ndebug)
_buildtype=release
configure_args="-Db_ndebug=true -Dtests=disabled -Db_lto=false"

# noctalia at _commit 451c391 requires C++23 <flat_set>/<print>, only
# available in libstdc++ from GCC 16+.  Build with our parallel gcc16 and
# rpath its libstdc++ so the binary resolves GLIBCXX_3.4.34+ symbols at
# runtime even on systems carrying only Void's gcc14 libstdc++.
# git: plugin git sources / auto-update shell out to `git` on PATH
# (PACKAGING.md Runtime, non-optional).  upower/ddcutil stay OUT:
# upower is D-Bus-only (no CLI needed) and ddcutil is explicitly an
# optional tracked tool with commandExists guards (dependency_service.cpp).
depends+=" libstdc++16>=16.1.1 git"
LDFLAGS+=" -Wl,-rpath,/opt/gcc16/lib64"
short_desc="Sleek, customizable desktop shell crafted for Wayland"
maintainer="Ackerman-00 <quietcraft@gmail.com>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia"

distfiles="https://github.com/noctalia-dev/noctalia/archive/${_commit}.tar.gz"
checksum="dbfb03dddec6ea49e5abc787cf1a3e85dca990572b3b8dc6a850478edf427270"

replaces="noctalia-v5>=0 noctalia-beta>=0"

hostmakedepends="meson ninja pkg-config"

makedepends="
gcc16 libstdc++16-devel
wayland-devel wayland-protocols libepoxy-devel
MesaLib-devel libglvnd-devel cairo-devel
pango-devel fontconfig-devel freetype-devel
harfbuzz-devel libxkbcommon-devel pipewire-devel wireplumber-devel
libsecret-devel libsodium-devel libical-devel
libcurl-devel pam-devel libwebp-devel libjxl-devel libsndfile-devel
basu-devel sdbus-c++-devel
libmd4c-devel tomlplusplus-devel
json-c++ stb
polkit-devel librsvg-devel libqalculate-devel libxml2-devel jemalloc-devel
glib-devel
"

pre_configure() {
	export CC=/usr/bin/gcc16
	export CXX=/usr/bin/g++16
}

post_install() {
	vlicense LICENSE
	vdoc README.md

	if [ ! -x "${DESTDIR}/usr/bin/noctalia" ]; then
		msg_error "Expected binary /usr/bin/noctalia not found.\n"
	fi
	# Upstream PACKAGING.md: shell completions are intentionally a
	# packaging step -- generate them from the freshly built binary.
	# Guarded so cross builds (binary not executable on host) skip
	# instead of failing.
	for sh in bash fish zsh; do
		if "${DESTDIR}/usr/bin/noctalia" completions "${sh}" > "noctalia.${sh}" 2>/dev/null; then
			vcompletion "noctalia.${sh}" "${sh}"
		else
			msg_warn "Skipping ${sh} completions: built binary not executable on build host.\n"
		fi
	done
}
