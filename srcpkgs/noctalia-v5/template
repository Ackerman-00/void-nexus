makedepends="
 wayland-devel wayland-protocols MesaLib-devel libglvnd-devel libepoxy-devel cairo-devel
 pango-devel fontconfig-devel freetype-devel harfbuzz-devel libxkbcommon-devel
 pipewire-devel wireplumber-devel libcurl-devel pam-devel libwebp-devel basu-devel sdbus-c++-devel
 polkit-devel librsvg-devel jemalloc-devel glib-devel libqalculate-devel libxml2-devel
 libmd4c-devel json-c++ tomlplusplus-devel stb
"

post_install() {
    vlicense LICENSE
    vdoc README.md

    if [ ! -x "${DESTDIR}/usr/bin/noctalia" ]; then
        msg_error "Expected binary /usr/bin/noctalia not found.\n"
    fi
}
