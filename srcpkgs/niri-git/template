# Template file for 'niri-git'
pkgname=niri-git
_basever=26.04
_commit=0add05dde70df3c6d70362913aa007fac4c31f91
_shortcommit=0add05d
_gitdate=20260811113951
version="${_basever}+git${_gitdate}.${_shortcommit}"
revision=1
build_style=cargo
build_helper="qemu"
configure_args="--no-default-features --features dbus,xdp-gnome-screencast"
hostmakedepends="pkg-config"
makedepends="cairo-devel eudev-libudev-devel glib-devel libdisplay-info-devel
 libgbm-devel libinput-devel libseat-devel libxkbcommon-devel MesaLib-devel
 pango-devel pipewire-devel pixman-devel clang19-devel"
depends="wayland xwayland-satellite-git"
checkdepends="wayland"
short_desc="Scrollable-tiling Wayland compositor (Git Snapshot)"
maintainer="Quietcraft <https://github.com/Ackerman-00>"
license="GPL-3.0-or-later"
homepage="https://github.com/niri-wm/niri"
changelog="https://github.com/niri-wm/niri/releases"
conflicts="niri>=0"
provides="niri-${version}_${revision}"
distfiles="https://github.com/niri-wm/niri/archive/${_commit}.tar.gz"
checksum="d246d0ea74e5156387d9595a014d26c6983f4209aeec76c33ee7550ab48a7489"
pre_check() {
	export XDG_RUNTIME_DIR=$(mktemp -d "$wrksrc/runtime.XXXXXX")
	ulimit -n 4096
}
do_check() {
	if [ "$XBPS_TARGET_LIBC" != "musl" ]; then
		cargo test --target ${RUST_TARGET} --workspace --locked -- --skip=::egl
	fi
}
post_install() {
	local sh
	vinstall resources/niri.desktop 644 usr/share/wayland-sessions
	vinstall resources/niri-portals.conf 644 usr/share/xdg-desktop-portal
	vsconf resources/default-config.kdl
	for sh in bash fish zsh; do
		vtargetrun "${DESTDIR}/usr/bin/niri" completions "${sh}" > "niri.${sh}"
		vcompletion "niri.${sh}" "${sh}"
	done
}
